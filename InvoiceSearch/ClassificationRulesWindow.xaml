<Window x:Class="InvoiceSearch.ClassificationRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klassifikationsregeln verwalten"
        Height="400" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hinzufügen" Width="100" Height="28" Click="OnAddClick" Margin="0,0,8,0"/>
            <Button Content="Bearbeiten" Width="100" Height="28" Click="OnEditClick" Margin="0,0,8,0"/>
            <Button Content="Löschen" Width="100" Height="28" Click="OnDeleteClick" Margin="0,0,8,0"/>
            <Button Content="Schließen" Width="100" Height="28" Click="OnCloseClick"/>
        </StackPanel>

        <ListView x:Name="RuleList" SelectionMode="Single" MouseDoubleClick="OnEditDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="160" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Muster" Width="220" DisplayMemberBinding="{Binding Pattern}"/>
                    <GridViewColumn Header="Aktion" Width="120" DisplayMemberBinding="{Binding Action}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
