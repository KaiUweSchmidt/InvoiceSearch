<Window x:Class="InvoiceSearch.ClassificationRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Klassifikationsregel"
        Height="280" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Content="Name:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4"/>

        <Label Grid.Row="1" Content="Muster:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PatternBox" Margin="0,4"/>

        <Label Grid.Row="2" Content="Aktion:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ActionBox"
                  Margin="0,4" Width="160" HorizontalAlignment="Left">
            <ComboBoxItem Content="Ausschließen" Tag="Exclude" IsSelected="True"/>
            <ComboBoxItem Content="Einschließen" Tag="Include"/>
        </ComboBox>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Speichern" Width="100" Height="30"
                    Click="OnSaveClick" IsDefault="True" Margin="0,0,8,0"/>
            <Button Content="Abbrechen" Width="100" Height="30"
                    Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
