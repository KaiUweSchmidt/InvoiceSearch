<Window x:Class="InvoiceSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvoiceSearch"
        mc:Ignorable="d"
        Title="InvoiceSearch" Height="550" Width="1050">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Konten" Click="OnAccountsClick"/>
                <Separator/>
                <MenuItem Header="_Beenden" Click="OnExitClick"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="SearchButton" Content="🔍 Suche starten" Click="OnSearchClick" Padding="8,2"/>
                <Button x:Name="CancelButton" Content="⏹ Abbrechen" Click="OnCancelClick" Padding="8,2" IsEnabled="False"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Bereit"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar x:Name="SearchProgress" Width="200" Height="16"
                             IsIndeterminate="True" Visibility="Collapsed"/>
            </StatusBarItem>
        </StatusBar>

        <DataGrid x:Name="ResultsGrid" IsReadOnly="True" AutoGenerateColumns="False"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#F9F9F9" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Von" Binding="{Binding From}" Width="180"/>
                <DataGridTextColumn Header="Eingangsdatum" Binding="{Binding ReceivedDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140"/>
                <DataGridTextColumn Header="Betreff" Binding="{Binding Subject}" Width="*"/>
                <DataGridTextColumn Header="Anhang" Binding="{Binding AttachmentName}" Width="160"/>
                <DataGridTextColumn Header="Rechnungsbetrag" Binding="{Binding InvoiceAmount, StringFormat='{}{0:N2} €'}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Rechnungsdatum" Binding="{Binding InvoiceDate}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
